<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="create-m_transunion_crb_corporate_logger" author="bosco@fiter.io">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_transunion_crb_corporate_logger"/>
            </not>
        </preConditions>
        <createTable tableName="m_transunion_crb_corporate_logger">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"  />
            </column>

            <column name="batch_id" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="has_passed" type="boolean" defaultValueBoolean="false">
                <constraints nullable="true" />
            </column>
            <column name="loan_id" type="int">
                <constraints nullable="true" />
            </column>
            <column name="crb_response_id" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="error_logs" type="TEXT">
                <constraints nullable="true" />
            </column>
            <column name="pay_load" type="TEXT">
                <constraints nullable="true" />
            </column>
            <column name="created_by" type="bigint">
                <constraints nullable="true" foreignKeyName="FK_m_transunion_crb_corporate_logger-created_by" references="m_appuser(id)"/>
            </column>
            <column name="last_modified_by" type="bigint">
                <constraints nullable="true" foreignKeyName="FK_m_transunion_crb_corporate_logger-lastmodifiedby_id" references="m_appuser(id)"/>
            </column>
            <column name="created_on_utc" type="timestamp" defaultValueComputed="now()">
                <constraints nullable="false" />
            </column>
            <column name="last_modified_on_utc" type="timestamp" defaultValueComputed="now()">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

