<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">


    <changeSet author="tabrez-fiter" id="1">
        <modifyDataType
                tableName="job"
                columnName="cron_expression"
                newDataType="varchar(50)"/>
    </changeSet>


    <changeSet author="tabrez-fiter" id="2">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM c_configuration WHERE name = 'standing-instruction-payday-deferral-enabled'
            </sqlCheck>
        </preConditions>
        <insert tableName="c_configuration">
            <column name="name" value="standing-instruction-payday-deferral-enabled"/>
            <column name="value"/>
            <column name="date_value"/>
            <column name="string_value"/>
            <column name="enabled" valueBoolean="false"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description" value="Defer standing-instruction loan repayments on payday until cutoff hour for configured loan products"/>
        </insert>
    </changeSet>

    <changeSet author="tabrez-fiter" id="3">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM c_configuration WHERE name = 'standing-instruction-payday-day-of-month'
            </sqlCheck>
        </preConditions>
        <insert tableName="c_configuration">
            <column name="name" value="standing-instruction-payday-day-of-month"/>
            <column name="value" valueNumeric="24"/>
            <column name="date_value"/>
            <column name="string_value"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description" value="Day of month for standing-instruction payday deferral. Valid values are 1-31."/>
        </insert>
    </changeSet>

    <changeSet author="tabrez-fiter" id="4">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM c_configuration WHERE name = 'standing-instruction-payday-cutoff-hour'
            </sqlCheck>
        </preConditions>
        <insert tableName="c_configuration">
            <column name="name" value="standing-instruction-payday-cutoff-hour"/>
            <column name="value" valueNumeric="23"/>
            <column name="date_value"/>
            <column name="string_value"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description" value="Tenant local hour from which configured payday loan repayments may run. Valid values are 0-23."/>
        </insert>
    </changeSet>

    <changeSet author="tabrez-fiter" id="5">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM c_configuration WHERE name = 'standing-instruction-payday-loan-product-ids'
            </sqlCheck>
        </preConditions>
        <insert tableName="c_configuration">
            <column name="name" value="standing-instruction-payday-loan-product-ids"/>
            <column name="value"/>
            <column name="date_value"/>
            <column name="string_value" value=""/>
            <column name="enabled" valueBoolean="true"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description" value="Comma-separated m_product_loan.id values affected by standing-instruction payday deferral."/>
        </insert>
    </changeSet>

    <changeSet author="tabrez-fiter" id="FS_update_execute_standing_instruction_cron">
        <update tableName="job">
            <column name="cron_expression" value="0 0 0,6,12,18,23 * * ?"/>
            <where>name = 'Execute Standing Instruction'</where>
        </update>
    </changeSet>

</databaseChangeLog>
