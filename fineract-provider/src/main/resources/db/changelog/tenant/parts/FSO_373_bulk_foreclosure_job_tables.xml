<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="FSO_373_1" author="tabrez-fiter">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_bulk_foreclosure_job"/>
            </not>
        </preConditions>
        <createTable tableName="m_bulk_foreclosure_job">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="job_id" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="foreclosure_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="total_loans" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="successful" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="failed" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="submitted_on" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="completed_on" type="DATETIME"/>
            <column name="submitted_by_user_id" type="BIGINT"/>
            <column name="execution_mode" type="VARCHAR(10)"/>
        </createTable>
    </changeSet>

    <changeSet id="FSO_373_2" author="tabrez-fiter">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_bulk_foreclosure_job_detail"/>
            </not>
        </preConditions>
        <createTable tableName="m_bulk_foreclosure_job_detail">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="bulk_foreclosure_job_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="loan_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="failure_reason" type="VARCHAR(500)"/>
            <column name="processed_on" type="DATETIME"/>
        </createTable>
    </changeSet>

    <changeSet id="FSO_373_3" author="tabrez-fiter">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_bulk_foreclosure_job_detail"/>
            <tableExists tableName="m_bulk_foreclosure_job"/>
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_bulk_foreclosure_detail_job"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint baseTableName="m_bulk_foreclosure_job_detail"
                                 baseColumnNames="bulk_foreclosure_job_id"
                                 constraintName="fk_bulk_foreclosure_detail_job"
                                 referencedTableName="m_bulk_foreclosure_job"
                                 referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="FSO_373_4" author="tabrez-fiter">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_bulk_foreclosure_job_detail"/>
            <tableExists tableName="m_loan"/>
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_bulk_foreclosure_detail_loan"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint baseTableName="m_bulk_foreclosure_job_detail"
                                 baseColumnNames="loan_id"
                                 constraintName="fk_bulk_foreclosure_detail_loan"
                                 referencedTableName="m_loan"
                                 referencedColumnNames="id"/>
    </changeSet>

    <!-- Index for idempotency check (existsByJob_IdAndLoanId) -->
    <changeSet id="FSO_373_5" author="tabrez-fiter">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_bulk_foreclosure_job_detail"/>
            <not>
                <indexExists tableName="m_bulk_foreclosure_job_detail" indexName="idx_bulk_foreclosure_detail_job_loan"/>
            </not>
        </preConditions>
        <createIndex tableName="m_bulk_foreclosure_job_detail" indexName="idx_bulk_foreclosure_detail_job_loan">
            <column name="bulk_foreclosure_job_id"/>
            <column name="loan_id"/>
        </createIndex>
    </changeSet>

    <!-- Index for ordering by submitted_on -->
    <changeSet id="FSO_373_6" author="tabrez-fiter">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_bulk_foreclosure_job"/>
            <not>
                <indexExists tableName="m_bulk_foreclosure_job" indexName="idx_bulk_foreclosure_job_submitted_on"/>
            </not>
        </preConditions>
        <createIndex tableName="m_bulk_foreclosure_job" indexName="idx_bulk_foreclosure_job_submitted_on">
            <column name="submitted_on" descending="true"/>
        </createIndex>
    </changeSet>

    <!-- Add loan_account_no column to job detail -->
    <changeSet id="FSO_373_7" author="tabrez-fiter">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_bulk_foreclosure_job_detail"/>
            <not>
                <columnExists tableName="m_bulk_foreclosure_job_detail" columnName="loan_account_no"/>
            </not>
        </preConditions>
        <addColumn tableName="m_bulk_foreclosure_job_detail">
            <column name="loan_account_no" type="VARCHAR(100)"/>
        </addColumn>
    </changeSet>

    <!-- Add client_name column to job detail -->
    <changeSet id="FSO_373_8" author="tabrez-fiter">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_bulk_foreclosure_job_detail"/>
            <not>
                <columnExists tableName="m_bulk_foreclosure_job_detail" columnName="client_name"/>
            </not>
        </preConditions>
        <addColumn tableName="m_bulk_foreclosure_job_detail">
            <column name="client_name" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <!-- Add permission for bulk foreclosure -->
    <changeSet id="FSO_373_9" author="tabrez-fiter">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_permission WHERE code = 'BULKFORECLOSURE_LOAN'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="transaction_loan"/>
            <column name="code" value="BULKFORECLOSURE_LOAN"/>
            <column name="entity_name" value="LOAN"/>
            <column name="action_name" value="BULKFORECLOSURE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <!-- Add permission for reading bulk foreclosure jobs -->
    <changeSet id="FSO_373_10" author="tabrez-fiter">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_permission WHERE code = 'READ_BULKFORECLOSUREJOB'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="transaction_loan"/>
            <column name="code" value="READ_BULKFORECLOSUREJOB"/>
            <column name="entity_name" value="BULKFORECLOSUREJOB"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <!-- Add permission for downloading bulk foreclosure report -->
    <changeSet id="FSO_373_11" author="tabrez-fiter">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_permission WHERE code = 'DOWNLOAD_BULKFORECLOSUREJOB'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="transaction_loan"/>
            <column name="code" value="DOWNLOAD_BULKFORECLOSUREJOB"/>
            <column name="entity_name" value="BULKFORECLOSUREJOB"/>
            <column name="action_name" value="DOWNLOAD"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>
