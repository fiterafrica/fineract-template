<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <changeSet author="deepika@fiter.io" id="042_add_status_to_import_document">

        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_import_document" columnName="status"/>
            </not>
        </preConditions>
        <addColumn tableName="m_import_document">
            <column defaultValueNumeric="100" name="status" type="SMALLINT">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!--
        Backfill for rows created before the status column existed. Any row already marked completed=true
        finished normally, so it becomes COMPLETED (300). Any row still completed=false at the time this
        migration runs has no background thread left that could ever finish it (the async job only lives in
        memory and does not survive an application restart), so it is treated as FAILED (600) rather than
        PENDING - otherwise it would permanently block new uploads of its entity type once the "an import is
        already in progress" check goes live.
    -->
    <changeSet author="deepika@fiter.io" id="042_backfill_completed_import_document_status">
        <update tableName="m_import_document">
            <column name="status" valueNumeric="300"/>
            <where>completed = true</where>
        </update>
    </changeSet>

    <changeSet author="deepika@fiter.io" id="042_backfill_incomplete_import_document_status">
        <update tableName="m_import_document">
            <column name="status" valueNumeric="600"/>
            <where>completed = false</where>
        </update>
    </changeSet>
</databaseChangeLog>
