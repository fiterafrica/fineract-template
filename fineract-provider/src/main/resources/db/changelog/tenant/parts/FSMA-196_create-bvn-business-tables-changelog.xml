<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" 
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog 
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Create BVN and Business more info tables with all constraints -->
    <changeSet author="deepika@fiter.io" id="CREATE_CLIENT_BVN_AND_BUSINESS_INFO_TABLES">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="BVN"/>
            </not>
            <not>
                <tableExists tableName="Business more info"/>
            </not>
        </preConditions>

        <!-- Create BVN table -->
        <createTable tableName="BVN">
            <column name="client_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="PRIMARY" nullable="false"/>
            </column>
            <column name="Clients BVN" type="VARCHAR(11)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="true"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <!-- Create Business more info table -->
        <createTable tableName="Business more info">
            <column name="client_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="PRIMARY" nullable="false"/>
            </column>
            <column name="Avg Monthly Revenue" type="INT">
                <constraints nullable="true"/>
            </column>
            <column name="Sector" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="Bank Name" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="Account Number" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="Type of Business" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="true"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="true"/>
            </column>
            <column name="Email address" type="TEXT">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <!-- Add foreign key for BVN table -->
        <addForeignKeyConstraint baseColumnNames="client_id"
                                 baseTableName="BVN"
                                 constraintName="fk_bvn_client_id"
                                 referencedColumnNames="id"
                                 referencedTableName="m_client"
                                 onDelete="RESTRICT"
                                 onUpdate="RESTRICT"/>

        <!-- Add foreign key for Business more info table -->
        <addForeignKeyConstraint baseColumnNames="client_id"
                                 baseTableName="Business more info"
                                 constraintName="fk_business_more_info_client_id"
                                 referencedColumnNames="id"
                                 referencedTableName="m_client"
                                 onDelete="RESTRICT"
                                 onUpdate="RESTRICT"/>

    </changeSet>
    
</databaseChangeLog>