<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" 
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog 
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    
    <!-- Update report name in stretchy_report table -->
    <changeSet author="deepika@fiter.io" id="UPDATE_REPORT_NAME_IN_STRETCHY_REPORT_1">
        
        <!-- Add precondition to check if the report exists -->
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM stretchy_report 
                WHERE report_name = 'Expected Payments By Date - Basic'
            </sqlCheck>
        </preConditions>
        
        <!-- Update the report name -->
        <update tableName="stretchy_report">
            <column name="report_name" value="Expected Payments By Date Basic"/>
            <where>report_name = 'Expected Payments By Date - Basic'</where>
        </update>
        
    </changeSet>

    <changeSet author="deepika@fiter.io" id="UPDATE_REPORT_NAME_IN_STRETCHY_REPORT_2">

        <!-- Add precondition to check if the report exists -->
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM stretchy_report
                WHERE report_name = 'Active Loans - Details'
            </sqlCheck>
        </preConditions>

        <!-- Update the report name -->
        <update tableName="stretchy_report">
            <column name="report_name" value="Active Loans Details"/>
            <where>report_name = 'Active Loans - Details'</where>
        </update>

    </changeSet>

    <changeSet author="deepika@fiter.io" id="UPDATE_REPORT_NAME_IN_STRETCHY_REPORT_3">

        <!-- Add precondition to check if the report exists -->
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM stretchy_report
                WHERE report_name = 'Active Loans - Summary'
            </sqlCheck>
        </preConditions>

        <!-- Update the report name -->
        <update tableName="stretchy_report">
            <column name="report_name" value="Active Loans Summary"/>
            <where>report_name = 'Active Loans - Summary'</where>
        </update>

    </changeSet>
    
</databaseChangeLog>