<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <changeSet author="brian@fiter.io" id="OXY-302_grace_extension_flag">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_charge" columnName="is_grace_extention"/>
            </not>
        </preConditions>
        <addColumn tableName="m_charge">
            <column name="is_grace_extention" type="boolean" defaultValueBoolean="false">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet author="brian@fiter.io" id="OXY-302_grace_loan_extension_days">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_loan_charge" columnName="grace_extension_days"/>
            </not>
        </preConditions>
        <addColumn tableName="m_loan_charge">
            <column name="grace_extension_days" type="integer" defaultValue="0"/>
        </addColumn>
    </changeSet>

    <changeSet id="update-regex-for-secure-password-validation-policy" author="bosco@fiter.io">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">Select count(0) from m_password_validation_policy where id = 2</sqlCheck>
        </preConditions>
        <sql>
            <![CDATA[
                UPDATE m_password_validation_policy SET regex = '^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[!@#$%^&*])(?!.*\\s).{6,50}$' WHERE id = 2;
               ]]>
        </sql>
    </changeSet>

    <changeSet author="bosco@fiter.io" id="FSO-154-add_account_transfer_id-column-to-m_loan_transaction">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_loan_transaction" columnName="account_transfer_id"/>
            </not>
        </preConditions>
        <addColumn tableName="m_loan_transaction">
            <column name="account_transfer_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet author="bosco@fiter.io" id="FSO-154-add_is_account_transfer-column-to-m_loan_transaction">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_loan_transaction" columnName="is_account_transfer"/>
            </not>
        </preConditions>
        <addColumn tableName="m_loan_transaction">
            <column name="is_account_transfer" type="BOOLEAN"/>
        </addColumn>
    </changeSet>


    <changeSet id="clean-up-loan-transaction-with-transfer-details-for-existing-loans_2" author="bosco@fiter.io">

        <sql>
            UPDATE m_loan_transaction mlt
            SET account_transfer_id = (
            SELECT matt.account_transfer_details_id
            FROM m_account_transfer_transaction matt
            INNER JOIN m_account_transfer_details matd ON matt.account_transfer_details_id = matd.id
            WHERE matt.to_loan_transaction_id = mlt.id
            AND matt.to_loan_transaction_id IS NOT NULL
            AND matt.is_reversed = false
            LIMIT 1
            ),
            is_account_transfer = true
            WHERE EXISTS (
            SELECT 1
            FROM m_account_transfer_transaction matt2
            INNER JOIN m_account_transfer_details matd2 ON matt2.account_transfer_details_id = matd2.id
            WHERE matt2.to_loan_transaction_id = mlt.id
            AND matt2.to_loan_transaction_id IS NOT NULL
            AND matt2.is_reversed = false
            )
            AND (mlt.is_reversed = false OR mlt.is_reversed IS NULL)
            AND mlt.account_transfer_id IS NULL;
        </sql>
    </changeSet>

    <changeSet id="alter-field_value-to-text-in-m_hook_configuration" author="bosco@fiter.io">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_hook_configuration"/>
            <columnExists tableName="m_hook_configuration" columnName="field_value"/>
        </preConditions>
        <modifyDataType tableName="m_hook_configuration" columnName="field_value" newDataType="TEXT"/>
    </changeSet>

    <changeSet author="bosco@fiter.io" id="FSO-282_add_configuration_to_enable_notification_to_user_for_checker_actions">

        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                select count(1) from c_configuration where name = 'Notify_user_on_checker_actions_enabled';
            </sqlCheck>
        </preConditions>

        <insert tableName="c_configuration">
            <column name="name" value="Notify_user_on_checker_actions_enabled"/>
            <column name="value" value="null"/>
            <column name="date_value" value="null"/>
            <column name="string_value" value="null"/>
            <column name="enabled" valueBoolean="false"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description" value="Enable notification for checker user"/>
        </insert>

    </changeSet>


</databaseChangeLog>
